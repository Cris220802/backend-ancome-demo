# Servidor
PORT=3000
NODE_ENV=development

# Seguridad — shared secret entre la app móvil y el backend
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe tener al menos 32 caracteres. Poner el mismo valor en la app móvil.
ANCOME_SECRET_KEY=

# CORS — lista separada por comas de orígenes permitidos (app móvil Expo)
ALLOWED_ORIGINS=http://localhost:8081,http://10.0.2.2:8081,exp://192.168.1.0:8081

# DeepSeek — API key + modelo + endpoint compatible OpenAI ChatCompletions
# Obtener API key en platform.deepseek.com
DEEPSEEK_API_KEY=
# Modelo para la generación del reporte final (síntesis profunda).
DEEPSEEK_MODEL=deepseek-v4-pro
# Modelo más rápido para los turnos del chat conversacional.
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Resend — API key + dominio verificado (resend.com/domains)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hub@notificaciones.tu-dominio.com
RESEND_FROM_NAME=Ancomebot

# Email defaults — asunto del correo enviado al visitante
REPORT_SUBJECT=Su diagnóstico personalizado de Ancome Soluciones

# (Opcional) Correo interno que recibirá una copia de cada lead generado en el stand
# (datos del visitante + respuestas + oportunidades + PDF adjunto). Persistencia simple
# para la fase demo. Dejar vacío si no se quiere notificación interna.
INTERNAL_NOTIFICATION_EMAIL=
