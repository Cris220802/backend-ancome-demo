# Servidor
PORT=3000
NODE_ENV=development

# Seguridad — shared secret entre la app móvil y el backend
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe tener al menos 32 caracteres. Poner el mismo valor en la app móvil.
ANCOME_SECRET_KEY=

# CORS — lista separada por comas de orígenes permitidos (app móvil Expo)
ALLOWED_ORIGINS=http://localhost:8081,http://10.0.2.2:8081,exp://192.168.1.0:8081

# Anthropic — API key para llamadas a Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Resend — API key + dominio verificado (resend.com/domains)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hub@notificaciones.tu-dominio.com
RESEND_FROM_NAME=Ancomebot

# Email defaults — asunto del correo enviado al visitante
REPORT_SUBJECT=Su diagnóstico personalizado de Ancome Soluciones
